# These defaults match your local Ollama setup.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:1.7b

# Optional: change the file workspace folder.
# AGENT_WORKSPACE=~/AgentWorkspace
